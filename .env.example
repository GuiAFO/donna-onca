# Copie para .env.local e preencha com os seus valores.
# (No deploy do GitHub Pages, configure estes como Secrets do repositório.)

# URL do Apps Script publicado (termina em /exec)
VITE_APPS_SCRIPT_URL=

# Token/senha — precisa ser IGUAL ao TOKEN definido no Apps Script (Codigo.gs)
VITE_APP_TOKEN=
